{
  "name": "openslot-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw"
    ],
    "overrides": {
      "cookie@^0.6.0": "^0.7.2",
      "@sveltejs/vite-plugin-svelte>deepmerge": "4.1.2"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "check": "node -e \"for (const p of ['.svelte-kit/.svelte-check', 'src/__tsgo_canary__.ts']) require('node:fs').rmSync(p, { recursive: true, force: true })\" && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:canary": "node scripts/check-canary.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:visual": "PLAYWRIGHT_BROWSERS_PATH=.playwright vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "test:browsers": "PLAYWRIGHT_SKIP_BROWSER_GC=1 PLAYWRIGHT_BROWSERS_PATH=.playwright playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "bits-ui": "^2.18.1",
    "playwright": "^1.61.0",
    "shadcn-svelte": "1.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^2.1.1"
  }
}
